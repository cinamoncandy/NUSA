[Unit]
Description=NUSA control: start gate (a runtime unit may start only if the host state file permits it)
DefaultDependencies=no
After=local-fs.target
Before=nusa.service nusa-research.timer nusa-research.service

[Service]
# No RemainAfterExit: once it has run it is inactive again, so every start of a runtime unit evaluates the gate again.
Type=oneshot
ExecStart=/opt/nusa-control/nusa-control.sh reconcile

[Install]
WantedBy=multi-user.target
