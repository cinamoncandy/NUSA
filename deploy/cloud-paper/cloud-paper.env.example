# NUSA autonomous PAPER production runtime. Copy to /etc/nusa/cloud-paper.env,
# chmod 0600, and replace all CHANGE_ME values before starting the service.
NUSA_MODE=PAPER
NUSA_LIVE_MUTATION=PROHIBITED

# The Node runtime remains loopback-only. TLS exposure belongs to the reverse proxy.
NUSA_CLOUD_DASHBOARD_HOST=127.0.0.1
NUSA_CLOUD_DASHBOARD_PORT=41731
NUSA_CLOUD_DASHBOARD_TOKEN=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET

# Durable production state. Never use :memory: here.
NUSA_CLOUD_STATE_DB_PATH=/var/lib/nusa/state.sqlite
NUSA_CLOUD_PAPER_INITIAL_CAPITAL_KRW=10000000
NUSA_CLOUD_PAPER_INVESTMENT_PERCENT=100

# PUBLIC quotations only. No exchange private credential belongs in this file.
NUSA_CLOUD_UPBIT_PUBLIC_DATA=true
NUSA_CLOUD_UPBIT_MARKETS=KRW-BTC,KRW-ETH

# Bind every deployment/evidence receipt to the exact protected-main source revision.
NUSA_SOURCE_COMMIT=CHANGE_ME_40_HEX_PROTECTED_MAIN_SHA
NUSA_CLOUD_SOURCE_VERSION=cloud-paper-production-v1
