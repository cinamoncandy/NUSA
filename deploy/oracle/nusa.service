[Unit]
Description=NUSA Cloud Paper Runtime
After=network-online.target
Wants=network-online.target
# At most 3 starts in 20 minutes, then the unit stays failed (no endless restart loop; the host gate and the owner alert take over).
StartLimitIntervalSec=20min
StartLimitBurst=3

[Service]
Type=simple
User=nusa
Group=nusa
WorkingDirectory=/opt/nusa/current
EnvironmentFile=/etc/nusa/cloud-runtime.env
Environment=HOME=/var/lib/nusa
ExecStart=/usr/bin/env -u NODE_OPTIONS /usr/bin/node /opt/nusa/current/scripts/start-cloud-runtime.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nusa /var/backups/nusa
UMask=0077

[Install]
WantedBy=multi-user.target
