{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nusa-autopilot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NUSA_EXECUTION_COORDINATOR",
        "class_name": "ExecutionCoordinator"
      }
    ]
  },
  "exports": {
    "ExecutionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
