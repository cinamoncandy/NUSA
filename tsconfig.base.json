{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@cloudflare/sandbox": ["node_modules/@cloudflare/sandbox/dist/index.d.ts"]
    },
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/nusa/tsconfig.base.tsbuildinfo",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts"]
}
