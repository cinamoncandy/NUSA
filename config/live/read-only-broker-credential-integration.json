{
  "version": 1,
  "mode": "READ_ONLY_BROKER_CREDENTIAL_INTEGRATION",
  "provider": "upbit",
  "brokerTransportClass": "OBSERVATION_ONLY",
  "readOnlyBrokerTransportAllowed": true,
  "executionTransportConnected": false,
  "liveTradingMutation": "prohibited",
  "realMoneyExecutionAllowed": false,
  "automaticLiveActivationAllowed": false,
  "credentials": {
    "storage": "OS_ENCRYPTED",
    "purpose": "READ_ONLY_BROKER_AUTH",
    "readOnlyResolutionAllowed": true,
    "executionUseAllowed": false,
    "rendererExposureAllowed": false,
    "aiExposureAllowed": false,
    "evidenceExposureAllowed": false,
    "logExposureAllowed": false
  },
  "allowedReadMethods": [
    "getAccounts",
    "getOrders",
    "getOpenOrders",
    "getOrder",
    "getOrderChance",
    "captureSnapshot"
  ],
  "prohibitedMutationMethods": [
    "submitOrder",
    "amendOrder",
    "cancelOrder",
    "withdraw",
    "deposit",
    "mutateCash",
    "mutatePosition"
  ],
  "reconciliation": {
    "portfolioMutationAllowed": false,
    "unknownBaselineResult": "UNKNOWN",
    "differenceResult": "DIFF",
    "matchResult": "MATCH"
  },
  "ciNetworkPolicy": {
    "realBrokerCallsAllowed": false,
    "mockTransportRequired": true
  }
}
