      "productionMutationAllowed": false,
      "credentialExecutionAllowed": false
    },
    {
      "id": "desktop-renderer-preload",
      "kind": "ELECTRON_RENDERER_BRIDGE",
      "path": "apps/desktop/src/preload.ts",
      "marker": "contextBridge.exposeInMainWorld(",
      "access": "LOCAL_PROCESS",
      "authority": "BOUNDED_RENDERER_API",
      "liveAuthority": "NONE",
      "productionMutationAllowed": false,
      "credentialExecutionAllowed": false
    },
    {
      "id": "desktop-ai-cio-readonly-ipc",
      "kind": "DELEGATED_READ_ONLY_IPC",
      "path": "apps/desktop/src/aiCioIpcBridge.ts",
      "marker": "registrar.handle(",
      "access": "LOCAL_PROCESS",
      "authority": "READ_ONLY",
      "liveAuthority": "NONE",
      "productionMutationAllowed": false,
      "credentialExecutionAllowed": false
    },
    {
      "id": "desktop-mobile-monitor-http",
      "kind": "LOCAL_HTTP",
