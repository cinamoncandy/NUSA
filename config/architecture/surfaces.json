      "productionMutationAllowed": false,
      "credentialExecutionAllowed": false
    },
    {
      "id": "cloud-dashboard-http",
      "kind": "CLOUD_HTTP",
      "path": "apps/cloud/src/server.ts",
      "marker": "http.createServer(",
      "access": "AUTHENTICATED_GET_ONLY",
      "authority": "READ_ONLY",
      "liveAuthority": "NONE",
      "productionMutationAllowed": false,
      "credentialExecutionAllowed": false
    },
    {
      "id": "operator-cli",
      "kind": "OPERATOR_CLI",
      "path": "scripts/nusa.js",
