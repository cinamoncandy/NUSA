{
  "name": "nusa",
  "private": true,
  "version": "0.1.0",
  "description": "Windows Electron paper-trading and deterministic research platform",
  "author": "NUSA contributors",
  "main": "dist/apps/desktop/src/cloudMain.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "postinstall": "node scripts/apply-security-backports.js",
    "preflight": "node scripts/check-runtime.js && node scripts/validate-repository-portability.js",
    "build": "tsc -p tsconfig.json && node scripts/run-changed-tests-fast.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/mobile/tsconfig.json --noEmit",
    "lint": "pnpm run lint:desktop && pnpm run lint:mobile",
    "lint:desktop": "eslint apps/desktop/renderer",
    "lint:mobile": "node scripts/lint-mobile.js",
    "test": "pnpm run preflight && pnpm run build && node scripts/run-tests-isolated.js",
    "test:ui": "vitest run --config vitest.config.mjs",
    "test:e2e": "playwright test",
    "coverage": "node scripts/run-coverage.js",
    "coverage:prepared": "node scripts/run-coverage.js --prepared",
    "test:coverage": "pnpm run coverage",
    "determinism": "node scripts/run-determinism-check.js",
    "architecture:check": "node scripts/validate-architecture.js && node scripts/validate-research-architecture.js && node scripts/validate-architecture-surfaces.js",
    "architecture:surfaces": "node scripts/validate-architecture-surfaces.js",
    "architecture:truth": "node scripts/validate-repository-truth.js",
    "ai:architecture": "node scripts/validate-ai-zero-authority.js",
    "architecture:lifecycle": "node scripts/validate-architecture-change-lifecycle.js",
    "aipos:drift": "node scripts/validate-aipos-drift.js",
    "aipos:conformance": "node scripts/validate-aipos-cross-ai-conformance.js",
    "aipos:provenance": "node scripts/validate-aipos-work-order-provenance.js",
    "capability:check": "node scripts/validate-capability-registry.js",
    "research:champion-challenger": "node scripts/validate-champion-challenger.js",
    "identity:check": "node scripts/validate-data-strategy-identity.js",
    "deployment:check": "node scripts/validate-deployment-bundles.js",
    "deployment:stage-promotion": "node scripts/strategy-stage-promotion-gate.js",
    "safety:architecture": "node scripts/validate-safety-architecture.js",
    "safety:invariants": "node scripts/validate-safety-invariants.js",
    "shadow:check": "node scripts/validate-shadow-governance.js",
    "restricted-live:check": "node scripts/validate-restricted-live-governance.js",
    "restricted-live:readiness": "node scripts/restricted-live-readiness-harness.js",
    "restricted-live:read-only-broker": "node scripts/validate-read-only-broker-credential-integration.js",
    "nusa": "node scripts/nusa.js",
    "verify:paper-runtime": "node scripts/nusa.js verify paper-runtime",
    "safety:inputs": "node scripts/check-safety-input-literals.js",
    "security:gate": "node scripts/security-gate-backports.js",
    "security:artifacts": "node scripts/security-gate-backports.js --artifacts release",
    "firebase:validate": "node scripts/validate-firebase-config.js",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "desktop": "pnpm run build && electron apps/desktop",
    "desktop:dev": "pnpm run build && electron apps/desktop",
    "cloud:runtime": "pnpm run build && node scripts/start-cloud-runtime.js",
    "cloud:runtime:bare": "pnpm run build && node dist/apps/cloud/src/runtime.js",
    "package:win": "pnpm run preflight && pnpm run build && node scripts/validate-package.js && electron-builder --win nsis",
    "package:portable": "pnpm run preflight && pnpm run build && node scripts/validate-package.js && electron-builder --config electron-builder.portable.yml --win portable",
    "package:validate": "node scripts/validate-windows-package.js",
    "release:check": "pnpm run preflight && pnpm run typecheck && pnpm run build && node scripts/release-readiness.js",
    "release:check:prepared": "node scripts/release-readiness.js",
    "release:manifest": "node scripts/release-manifest.js",
    "release:validate": "node scripts/validate-release-process.js",
    "release:artifacts": "pnpm run release:manifest && node scripts/release-artifacts.js",
    "evidence:rehearse": "pnpm run preflight && pnpm run build && node scripts/evidence-rehearse.js",
    "evidence:status": "pnpm run preflight && pnpm run build && node scripts/evidence-cli.js status",
    "evidence:checklist": "pnpm run preflight && pnpm run build && node scripts/evidence-checklist.js",
    "evidence:export": "pnpm run preflight && pnpm run build && node scripts/evidence-cli.js export",
    "evidence:verify": "pnpm run preflight && pnpm run build && node scripts/evidence-cli.js verify",
    "research:evidence-import": "pnpm run preflight && pnpm run build && node scripts/import-research-evidence.js",
    "research:evidence-bundle-import": "pnpm run preflight && pnpm run build && node scripts/import-research-evidence-bundle.js",
    "opportunity:schedule-import": "pnpm run preflight && pnpm run build && node scripts/import-opportunity-schedule.js",
    "research:evidence-status": "pnpm run preflight && pnpm run build && node scripts/research-evidence-status.js",
    "runtime:diagnostics-validate": "pnpm run preflight && pnpm run build && node scripts/validate-runtime-diagnostics.js",
    "research:real-run": "pnpm run preflight && pnpm run build && node scripts/research-real-market-run.js"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@storybook/addon-a11y": "8.6.17",
    "@storybook/web-components": "8.6.17",
    "@storybook/web-components-vite": "8.6.17",
    "@types/node": "24.0.0",
    "@types/ws": "8.5.13",
    "@vitest/coverage-v8": "3.2.6",
    "c8": "10.1.3",
    "electron": "41.10.3",
    "electron-builder": "26.15.3",
    "eslint": "9.39.1",
    "jsdom": "26.0.0",
    "storybook": "8.6.17",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.13.0-next.751.1",
    "image-size": "1.2.1",
    "ws": "8.21.0"
  },
  "build": {
    "appId": "com.nusa.trader",
    "productName": "NUSA",
    "asar": true,
    "directories": {"output": "release"},
    "files": ["dist/**/*","apps/desktop/renderer/**/*","apps/desktop/package.json","package.json","!**/*.ts","!**/*.map","!**/tests{,/**/*}","!**/docs{,/**/*}"],
    "extraMetadata": {"main": "dist/apps/desktop/src/cloudMain.js"},
    "win": {"target": "nsis","icon": "build/nusa-a4p.ico","artifactName": "NUSA-${version}-Windows-Setup.${ext}","signAndEditExecutable": false},
    "nsis": {"oneClick": false,"perMachine": false,"allowToChangeInstallationDirectory": false,"createDesktopShortcut": true,"createStartMenuShortcut": true,"deleteAppDataOnUninstall": false}
  }
}
