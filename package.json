{
  "name": "dokkaebi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test --test-reporter=spec tests/*.test.js",
    "desktop": "pnpm run build && electron apps/desktop",
    "desktop:dev": "pnpm run build && electron apps/desktop",
    "package:win": "pnpm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/ws": "8.5.13",
    "electron": "39.0.0",
    "electron-builder": "26.0.12",
    "typescript": "5.9.3",
    "ws": "8.18.3"
  },
  "build": {
    "appId": "com.dokkaebi.trader",
    "productName": "Dokkaebi",
    "files": [
      "dist/**/*",
      "apps/desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
