{
  "name": "dokkaebi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps/desktop/renderer",
    "test": "pnpm run build && node --test tests/*.test.js",
    "test:ui": "vitest run --config vitest.config.mjs",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "desktop": "pnpm run build && electron apps/desktop",
    "desktop:dev": "pnpm run build && electron apps/desktop",
    "package:win": "pnpm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/ws": "8.5.13",
    "@playwright/test": "1.52.0",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/web-components": "8.6.14",
    "@storybook/web-components-vite": "8.6.14",
    "electron": "39.0.0",
    "electron-builder": "26.0.12",
    "eslint": "9.39.1",
    "jsdom": "26.0.0",
    "storybook": "8.6.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "ws": "8.18.3"
  },
  "build": {
    "appId": "com.dokkaebi.trader",
    "productName": "Dokkaebi",
    "files": [
      "dist/**/*",
      "apps/desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
